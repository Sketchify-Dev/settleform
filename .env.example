# Copy to .env.local and fill in. Never commit real keys.
ONECLICK_JWT=

# The public origin. metadataBase, canonical URLs, robots.txt and sitemap.xml all
# read it. Left empty it falls back to http://localhost:3000, which is right for
# local dev. On Vercel this is set to https://settleform.vercel.app.
NEXT_PUBLIC_SITE_URL=

# Set to 1 only when a proxy in front of this process sets x-forwarded-for. The
# rate limiter does not trust that header on its own, because a caller can send
# it too. Left empty, every caller shares one bucket.
TRUST_PROXY=
